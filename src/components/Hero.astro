---
import HeroApp from './react/Hero';
import TrustBar from './TrustBar.astro';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
---

<div class="hero-stage">
	<HeroApp
		client:idle
		locale={locale}
		siteName={siteConfig.name}
		checkoutUrl={siteConfig.checkoutUrl}
		monthlyPrice={monthly.price}
		heroSrc={heroSrc}
		heroSrcSet={heroSrcSet}
		heroSizes={heroSizes}
		heroWidth={heroWidth}
		heroHeight={heroHeight}
		heroVideoUrl={siteConfig.heroVideoUrl}
		useBrandHero={true}
	/>
	<TrustBar locale={locale} overlay />
</div>

<style is:global>
	.hero-stage {
		position: relative;
		container-type: inline-size;
		container-name: hero-stage;
	}

	.hero {
		--hero-ratio-wide: 3.15;
		--hero-pad-y: clamp(0.85rem, 1.5cqi + 0.35rem, 1.75rem);
		--hero-stack: clamp(0.45rem, 0.85cqi + 0.2rem, 0.75rem);
		--hero-copy-max: min(100%, max(16rem, 42cqi));
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: var(--bg);
		width: 100%;
		aspect-ratio: var(--hero-ratio-wide) / 1;
		min-height: clamp(16rem, calc(100cqi / var(--hero-ratio-wide)), 24rem);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media picture,
	.hero__media img,
	.hero__media video {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__media img,
	.hero__media video {
		object-fit: cover;
		/* Character sits on the right; anchor high so helmets stay in frame */
		object-position: 72% 12%;
		transform: translateZ(0);
		filter: brightness(0.78) contrast(1.04);
		animation: hero-in 0.9s ease-out both;
	}

	.hero__media img {
		image-rendering: auto;
	}

	.hero__poster-fallback {
		display: none;
		position: absolute;
		inset: 0;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--bg) 22%, transparent) 0%,
				transparent 42%,
				color-mix(in srgb, var(--bg) 28%, transparent) 100%
			),
			linear-gradient(
				90deg,
				color-mix(in srgb, var(--bg) 84%, transparent) 0%,
				color-mix(in srgb, var(--bg) 58%, transparent) 34%,
				color-mix(in srgb, var(--bg) 28%, transparent) 58%,
				color-mix(in srgb, var(--bg) 12%, transparent) 74%,
				color-mix(in srgb, var(--bg) 18%, transparent) 100%
			);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		pointer-events: none;
		padding-block: var(--hero-pad-y);
		align-self: center;
		transform: translateY(clamp(-1.5rem, -2.5cqi, -0.35rem));
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--hero-stack);
		width: var(--hero-copy-max);
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		animation: rise 0.65s ease-out both;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 1.1rem + 3.2cqi, 3.25rem);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: var(--type-display-tracking-wide);
		text-transform: uppercase;
		width: 100%;
		max-width: 100%;
		color: #fff;
		word-break: break-word;
		hyphens: auto;
		overflow-wrap: anywhere;
	}

	.hero__lede {
		margin: 0;
		width: 100%;
		max-width: min(100%, 38ch);
		font-size: clamp(0.875rem, 0.8rem + 0.65cqi, 1.05rem);
		line-height: 1.5;
		color: color-mix(in srgb, #fff 74%, var(--ink-muted));
		word-break: break-word;
		hyphens: auto;
		overflow-wrap: break-word;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(0.5rem, 1.5cqi, 0.7rem);
		margin: 0;
		width: 100%;
	}

	.hero__buy {
		pointer-events: auto;
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: clamp(0.4rem, 1cqi, 0.55rem);
		width: fit-content;
		max-width: 100%;
		min-height: clamp(2.75rem, 5cqi, 3rem);
		padding-block: clamp(0.45rem, 1cqi, 0.55rem);
		padding-inline: clamp(0.45rem, 1cqi, 0.55rem) clamp(0.85rem, 2cqi, 1.05rem);
		border-radius: var(--radius-pill);
		background: #fff;
		color: #09090b;
		font-size: clamp(0.8125rem, 0.75rem + 0.45cqi, 0.9375rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset,
			0 10px 28px rgba(0, 0, 0, 0.28);
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			box-shadow 0.18s ease;
	}

	.hero__buy svg {
		width: clamp(0.95rem, 2cqi, 1.05rem);
		height: clamp(0.95rem, 2cqi, 1.05rem);
		flex-shrink: 0;
		opacity: 0.85;
	}

	.hero__buy-label {
		padding-inline-end: 0.15rem;
		min-width: 0;
		word-break: break-word;
	}

	.hero__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: clamp(1.85rem, 4cqi, 2rem);
		margin-inline-start: auto;
		padding-inline: clamp(0.65rem, 1.5cqi, 0.85rem);
		border-radius: var(--radius-pill);
		background: #09090b;
		color: #fff;
		font-size: clamp(0.75rem, 0.7rem + 0.35cqi, 0.8125rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		flex-shrink: 0;
	}

	.hero__buy:hover {
		background: #f4f4f5;
		color: #09090b;
		transform: translateY(-2px);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset,
			0 14px 32px rgba(0, 0, 0, 0.34);
	}

	.hero__buy:hover .hero__buy-price {
		background: var(--magenta);
	}

	.hero__buy:active {
		transform: translateY(0);
	}

	.hero__features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
		gap: clamp(0.35rem, 1.5cqi, 0.55rem) clamp(0.5rem, 2cqi, 1rem);
		margin: 0;
		padding: 0;
		list-style: none;
		width: 100%;
		max-width: none;
	}

	.hero__features li {
		display: flex;
		align-items: center;
		gap: clamp(0.35rem, 1cqi, 0.5rem);
		min-width: 0;
		font-size: clamp(0.75rem, 0.7rem + 0.35cqi, 0.8125rem);
		font-weight: 500;
		line-height: 1.3;
		color: color-mix(in srgb, #fff 72%, transparent);
		word-break: break-word;
		hyphens: auto;
	}

	.hero__features li span {
		min-width: 0;
		overflow-wrap: break-word;
	}

	.hero__features svg {
		width: clamp(0.9rem, 2cqi, 1rem);
		height: clamp(0.9rem, 2cqi, 1rem);
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__media img,
		.hero__media video {
			animation: none;
		}

		.hero__media video {
			display: none;
		}

		.hero__poster-fallback {
			display: block;
		}

		.hero__buy,
		.hero__buy:hover {
			transition: none;
			transform: none;
		}

		.hero__content {
			transform: translateY(clamp(-1.5rem, -2.5cqi, -0.35rem));
		}
	}

	@container hero-stage (width < 56rem) {
		.hero {
			aspect-ratio: auto;
			min-height: clamp(20rem, 75cqi, 28rem);
			align-items: end;
		}

		.hero__media img,
		.hero__media video {
			object-position: 72% 15%;
		}

		.hero__veil {
			background:
				linear-gradient(
					180deg,
					color-mix(in srgb, var(--bg) 35%, transparent) 0%,
					color-mix(in srgb, var(--bg) 58%, transparent) 42%,
					color-mix(in srgb, var(--bg) 92%, transparent) 78%,
					color-mix(in srgb, var(--bg) 97%, transparent) 100%
				);
		}

		.hero__content {
			transform: none;
			align-self: end;
			display: flex;
			align-items: flex-end;
			padding-block: clamp(1rem, 3cqi, 1.35rem);
			/* Reserve space for the overlay trust bar at the hero bottom */
			padding-block-end: max(
				clamp(2.75rem, 7cqi, 3.5rem),
				env(safe-area-inset-bottom, 0px)
			);
		}

		.hero__copy {
			width: min(100%, max(16rem, 88cqi));
		}

		.hero__lede {
			max-width: min(100%, 34ch);
			color: color-mix(in srgb, #fff 80%, var(--ink-muted));
		}

		.hero__buy {
			width: min(100%, 22rem);
			min-height: var(--touch-min);
		}
	}

	@container hero-stage (width < 30rem) {
		.hero__buy {
			width: 100%;
		}

		.hero__lede {
			max-width: 100%;
		}
	}

	@container hero-stage (width < 22.5rem) {
		.hero__features {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@container hero-stage (width < 56rem) and (max-aspect-ratio: 5/3) {
		.hero {
			min-height: min(70dvh, 16.5rem);
		}

		.hero__content {
			padding-block-start: clamp(0.75rem, 2cqi, 0.85rem);
			padding-block-end: max(
				clamp(2.5rem, 6cqi, 3rem),
				env(safe-area-inset-bottom, 0px)
			);
		}

		.hero__lede {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
		}

		.hero__features {
			display: none;
		}

		.hero__buy {
			width: min(100%, 20rem);
		}
	}
</style>
