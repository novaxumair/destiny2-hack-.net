---
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getT(locale);
const pillarHref = getLocalizedPath('hacks', locale);
const espHref = getLocalizedPath('destiny-2-esp', locale);
const aimbotHref = getLocalizedPath('destiny-2-aimbot', locale);
const updatesHref = getLocalizedPath('updates', locale);
---

<section class="shell home__prose home__prose--en" aria-labelledby="home-about-title">
	<div class="home__prose-grid">
		<div class="home__prose-callout">
			<h2 id="home-about-title">{t('home.aboutTitle')}</h2>
			<p>{t('home.aboutP1')}</p>
			<p>
				{t('home.aboutP2Before')}{' '}
				<a href={pillarHref}>{t('home.aboutPillar')}</a>
				{t('home.aboutP2Mid')}
				<a href={espHref}>{t('home.aboutEsp')}</a>
				{t('home.aboutP2Mid')}
				<a href={aimbotHref}>{t('home.aboutAimbot')}</a>
				{t('home.aboutP2Or')}
				<a href={updatesHref}>{t('home.aboutUndetected')}</a>
				{t('home.aboutP2After')}
			</p>
		</div>
		<figure class="home__prose-media">
			<img
				src="/images/destiny2-about-showcase.webp"
				alt="Destiny 2 Cheats movement hack with jump height multiplier in Vex zone"
				width="960"
				height="540"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</div>
</section>

<style is:global>
	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__prose-grid {
		container-type: inline-size;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: center;
	}

	.home__prose-callout {
		max-width: none;
		min-width: 0;
		padding-inline-start: clamp(0.85rem, 2vw, 1.1rem);
		border-inline-start: 3px solid var(--magenta);
		word-break: break-word;
		hyphens: auto;
	}

	.home__prose-media {
		margin: 0;
		width: 100%;
		min-width: 0;
	}

	.home__prose-media img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
		object-fit: cover;
		aspect-ratio: 16 / 9;
	}

	.home__prose-callout h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: var(--type-display-tracking);
		color: var(--ink);
	}

	.home__prose-callout p {
		margin: 0 0 clamp(0.55rem, 1.5vw, 0.75rem);
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: var(--fluid-text-base);
		overflow-wrap: break-word;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__prose--en a {
		color: var(--link);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:hover {
		color: var(--accent-hover);
	}

	@container (min-width: 56rem) {
		.home__prose-media {
			justify-self: end;
			max-width: min(100%, 34rem);
		}
	}
</style>
