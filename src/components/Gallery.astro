---
import { destiny2Images } from '../data/destiny2';
import { getGalleryUi } from '../data/i18n/gallery-ui';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrcSet, galleryTileSizes } from '../lib/responsive-images';
import { absoluteImageUrl } from '../data/page-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const gallery = getGalleryUi(locale);

const galleryImages = destiny2Images.gallery.map((image) => ({
	src: image.src,
	url: 'url' in image && image.url ? image.url : absoluteImageUrl(image.src),
	alt: image.alt,
}));
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<h2 id="gallery-title" class="gallery__title">{gallery.title}</h2>
	<p class="gallery__sub">{gallery.subtitle}</p>

	<div class="gallery__grid">
		{
			galleryImages.map((image) => (
				<figure class="gallery__item media-frame" itemscope itemtype="https://schema.org/ImageObject">
					<link itemprop="url" href={image.url} />
					<meta itemprop="contentUrl" content={image.url} />
					<img
						src={image.src}
						srcset={contentSrcSet(image.src)}
						sizes={galleryTileSizes}
						alt={image.alt}
						itemprop="contentUrl"
						width="640"
						height="400"
						loading="lazy"
						decoding="async"
					/>
					<meta itemprop="name" content={image.alt} />
				</figure>
			))
		}
	</div>
</section>

<style>
	.gallery__title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.gallery__sub {
		margin: 0.5rem 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
		line-height: 1.5;
		max-width: 36rem;
	}

	.gallery__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
		gap: 0.75rem;
		max-width: var(--content-max);
	}

	.gallery__item {
		margin: 0;
		aspect-ratio: 16 / 10;
		max-width: 18rem;
	}
</style>
